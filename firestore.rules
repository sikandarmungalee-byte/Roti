rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Connection testing
    match /test/{docId} {
      allow read, write: if request.auth != null;
    }

    // User-scoped data: Each user has full read/write access to their own sandbox
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{allChildren=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
